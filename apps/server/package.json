{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@saudaai/shared": "workspace:*",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "hono": "^4.13.14",
    "nanoid": "^6.0.2",
    "p-queue": "^10.0.0",
    "pino": "^10.4.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
