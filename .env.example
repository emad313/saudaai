NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
LOG_LEVEL=info
DATABASE_URL=file:./data/saudaai.db
# Turso (libsql://...) for hosts that wipe the disk; media is then copied into the database too
DATABASE_AUTH_TOKEN=
MEDIA_DIR=./data/media
DEMO_READONLY=0
DEMO_SHOP_SLUG=my-shop

AGENT_PROVIDER=meta
MODEL_DAILY_CALL_LIMIT=500
# optional, USD, for the cost estimate on the Analytics page
MODEL_PRICE_INPUT_PER_M=1.25
MODEL_PRICE_OUTPUT_PER_M=4.25
MODEL_PRICE_PER_IMAGE=0.01

# encrypts connected store tokens, 32 random bytes: openssl rand -base64 32
STORE_SECRET_KEY=
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_AGENT_MODEL=muse-spark-1.3
META_VISION_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling

GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_REMINDER_TEMPLATE=payment_reminder
WHATSAPP_TEMPLATE_LANG=bn

# optional, open-weight path
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# apps/demo-store: a sample site that implements the SaudaAI Store API (pnpm demo, then pnpm demo:link)
DEMO_STORE_PORT=8790
DEMO_STORE_URL=http://localhost:8790
DEMO_STORE_TOKEN=
DEMO_STORE_SAUDAAI_URL=
DEMO_STORE_SHOP_ID=
DEMO_STORE_WEBHOOK_SECRET=
DEMO_STORE_PUBLIC_KEY=
